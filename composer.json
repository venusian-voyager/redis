{
    "name": "voyager/redis",
    "description": "The Voyager Redis package.",
    "license": "MIT",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        },
        {
            "name": "Taylor Otwell"
        }
    ],
    "require": {
        "php": "^8.4|^8.5",
        "voyager/collections": "^0.8.0",
        "voyager/contracts": "^0.8.0",
        "voyager/macroable": "^0.8.0",
        "voyager/nuts-and-bolts": "^0.8.0"
    },
    "suggest": {
        "ext-redis": "Required to use the phpredis connector (^4.0|^5.0|^6.0).",
        "predis/predis": "Required to use the predis connector (^2.3|^3.0)."
    },
    "autoload": {
        "psr-4": {
            "Voyager\\Redis\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.8.x-dev"
        },
        "venusian": {
            "upstream": "laravel/framework",
            "upstream-ref": "v12.67.0",
            "upstream-path": "src/Illuminate/Redis",
            "ported-at": "2026-08-20"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev"
}
