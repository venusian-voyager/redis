{
    "name": "venusian-voyager/redis",
    "description": "The Voyager Redis package.",
    "license": "MIT",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        },
        {
            "name": "Taylor Otwell"
        }
    ],
    "require": {
        "php": "^8.4|^8.5",
        "venusian-voyager/collections": "^0.10.0",
        "venusian-voyager/contracts": "^0.10.0",
        "venusian-voyager/macroable": "^0.10.0",
        "venusian-voyager/nuts-and-bolts": "^0.10.0"
    },
    "suggest": {
        "ext-redis": "Required to use the phpredis connector (^4.0|^5.0|^6.0).",
        "predis/predis": "Required to use the predis connector (^2.3|^3.0).",
        "venusian-voyager/io-pools": "Required for listPush() and listPop(): their sockets wait on its loop (^0.10.0)."
    },
    "autoload": {
        "psr-4": {
            "Voyager\\Redis\\": ""
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev"
}
